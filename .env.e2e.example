# E2E / QA local — production-like (copy to .env.e2e, không commit)
# cp .env.e2e.example .env.e2e

NODE_ENV=production
E2E_TEST_MODE=1
NEXT_PUBLIC_E2E_TEST_MODE=1
E2E_FIXED_OTP=424242

SESSION_SECRET=local-e2e-session-secret-do-not-use-in-production
CACHE_REVALIDATE_SECRET=local-e2e-cron-secret

# Postgres local (Docker hoặc native)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vn_insurance_fti_qa?schema=public

# Turnstile test keys (Cloudflare docs — luôn pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

HR_CONTACT_EMAIL=hr-demo@example.com
HR_EMAIL_FROM=noreply@example.com

# Không gửi email thật trong QA
HRIS_SOURCE=mock
